{
  "name": "taskmaster-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --watch server.js",

    "test": "npm run test:unit",

    "test:unit": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config=jest.config.cjs --runInBand --testPathPattern=tests/unit",

    "test:unit:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config=jest.config.cjs --runInBand --watch --testPathPattern=tests/unit",

    "test:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config=jest.config.cjs --runInBand --coverage --collectCoverageFrom=utils/**/*.js --testPathPattern=tests/unit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.1.2",
    "cross-env": "^10.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
